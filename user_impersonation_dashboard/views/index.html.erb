<div class="row">
    <div class="col-md-12 mb-3">
    <!-- Messages to the user about their processes -->
    <% if flash[:success_impersonated_user] %>
        <br>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <%= flash[:success_impersonated_user] %>
        </div>
    <% end %>
    
    <% if flash[:error] %>
        <br>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= flash[:error] %>
        </div>
    <% end %>

    <!-- User Impersonation section of the portal -->
        <h3>Admin Portal</h3>
        <h4 class="apps-section-header-blue">User Impersonation</h4>

        <%= form_with(model: @admin_impersonation, url: admin_update_impersonation_path, local: true) do |form| %>

            <div class="form-group">
                <label>Impersonation Username</label>
                <%= form.text_field :impersonation_username, class: 'form-control', required: true %>
                <small class="form-text text-muted">
                    <p>This is the username of the user that will be impersonated.</p>
                </small>
            </div>

            <div class="form-group">
                <label>Reason</label>
                <%= form.text_field :impersonation_reason, class: 'form-control', required: true %>
                <small class="form-text text-muted">
                    <p>Provide a detailed description of the reason you are impersonating this user including ticket number, etc. This will be logged.</p>
                </small>
            </div>

            <%= form.submit "Update Impersonated User", class: 'btn btn-primary' %>
        <% end %>
    </div>
</div>

